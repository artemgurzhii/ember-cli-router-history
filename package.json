{
  "name": "ember-cli-router-history-workspace",
  "version": "0.1.6",
  "private": true,
  "description": "Workspace root for ember-cli-router-history (V2 addon + test-app)",
  "repository": "https://github.com/artemgurzhii/ember-cli-router-history",
  "license": "GPL-3.0",
  "author": "Artem Hurzhii",
  "workspaces": [
    "ember-cli-router-history",
    "test-app"
  ],
  "scripts": {
    "build": "pnpm --filter ember-cli-router-history build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "start": "pnpm --parallel --filter ember-cli-router-history --filter test-app start",
    "start:addon": "pnpm --filter ember-cli-router-history start",
    "start:test-app": "pnpm --filter test-app start",
    "test": "pnpm --filter test-app test",
    "test:ember-compatibility": "pnpm --filter test-app test:ember-compatibility"
  },
  "engines": {
    "node": ">= 18"
  },
  "packageManager": "pnpm@9.1.0",
  "volta": {
    "node": "24.15.0",
    "pnpm": "9.1.0"
  },
  "pnpm": {
    "overrides": {
      "@glimmer/component": "^1.1.2"
    },
    "peerDependencyRules": {
      "allowAny": [
        "@glimmer/component",
        "ember-source",
        "typescript"
      ]
    }
  }
}
