{
  "name": "ember-cli-router-history",
  "version": "0.1.9",
  "description": "Ember router history with local storage and query params support.",
  "keywords": [
    "ember-addon",
    "ember-router",
    "ember-history",
    "ember-router-history",
    "ember-cli-router-history"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artemgurzhii/ember-cli-router-history.git",
    "directory": "ember-cli-router-history"
  },
  "license": "GPL-3.0",
  "author": "Artem Hurzhii",
  "exports": {
    ".": {
      "types": "./declarations/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./declarations/*.d.ts",
      "default": "./dist/*.js"
    },
    "./addon-main.js": "./addon-main.cjs"
  },
  "typesVersions": {
    "*": {
      "*": [
        "declarations/*"
      ]
    }
  },
  "files": [
    "addon-main.cjs",
    "declarations",
    "dist"
  ],
  "scripts": {
    "build": "rollup --config",
    "format": "prettier --write .",
    "lint": "concurrently \"npm:lint:*(!fix)\" --names \"lint:\"",
    "lint:fix": "concurrently \"npm:lint:*:fix\" --names \"fix:\" && npm run format",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:package": "publint",
    "lint:prettier": "prettier --check .",
    "lint:types": "ember-tsc --noEmit",
    "prepack": "rollup --config",
    "start": "rollup --config --watch --no-watch.clearScreen",
    "test": "echo 'A v2 addon does not have tests, run tests in test-app'"
  },
  "peerDependencies": {
    "@glimmer/tracking": "^1.0.0 || ^2.0.0",
    "ember-source": ">= 4.12.0"
  },
  "peerDependenciesMeta": {
    "@glimmer/tracking": {
      "optional": true
    }
  },
  "dependencies": {
    "@embroider/addon-shim": "^1.10.2",
    "decorator-transforms": "2.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-typescript": "^7.28.6",
    "@babel/preset-typescript": "^7.28.5",
    "@embroider/addon-dev": "^8.3.0",
    "@ember/library-tsconfig": "^2.0.0",
    "@glimmer/component": "^1.1.2",
    "@glimmer/tracking": "^1.1.2",
    "@glint/ember-tsc": "^1.1.1",
    "@glint/template": "1.7.7",
    "@nullvoxpopuli/eslint-configs": "^5.5.0",
    "@rollup/plugin-babel": "^7.0.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "babel-plugin-ember-template-compilation": "^4.0.0",
    "concurrently": "^9.2.1",
    "ember-source": "^5.12.0",
    "ember-template-lint": "^7.9.3",
    "eslint": "^9.39.2",
    "prettier": "^3.8.1",
    "prettier-plugin-ember-template-tag": "^2.1.3",
    "publint": "^0.3.17",
    "rollup": "^4.57.1",
    "rollup-plugin-copy": "^3.5.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">= 20.11"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "version": 2,
    "type": "addon",
    "main": "addon-main.cjs",
    "app-js": {
      "./services/router-history.js": "./dist/_app_/services/router-history.js"
    }
  }
}
